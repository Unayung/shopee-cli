            lines.append(f"品牌:   {p['brand']}")
        lines.append(f"賣家:   {p['shop'].get('name') or ''} ({p['shopid']})" + (" 商城" if p['shop'].get('official') else "")
                     + (f"  {p['shop_location']}" if p.get("shop_location") else ""))
