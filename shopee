def parse_pdp(data, shopid, itemid):
    """/api/v4/pdp/get_pc data -> product dict. Price fields (measured): item.price_min
    / price_max are the variant range now (after product promotion); models[].price per
    variant; product_price.price.single_value / range_* is the voucher-applied "券後價"
    when product_price.has_final_price (e.g. 995 -> 915 with shop voucher NT$80)."""
    it = data.get("item") or {}
    shop = data.get("shop_detailed") or {}
    pp = data.get("product_price") or {}
    hidden = it.get("hidden_price_display") or pp.get("hide_price") or None
    tiers = [{"name": t.get("name"), "options": t.get("options") or []} for t in it.get("tier_variations") or []
             if t.get("name") or t.get("options")]
    models = []
    for m in it.get("models") or []:
        idx = (m.get("extinfo") or {}).get("tier_index") or []
        models.append({
            "modelid": m.get("model_id"),
            "name": m.get("name"),
            "tier_index": idx,
            "price": None if hidden else twd(m.get("price")),
            "orig_price": twd(m.get("price_before_discount")) or (None if hidden else twd(m.get("price"))),
            "stock": m.get("stock") if m.get("stock") is not None else ("有貨" if m.get("has_stock") else 0),
            "in_stock": bool(m.get("has_stock")) and not m.get("is_grayout") and m.get("status", 1) == 1,
        })
    fp = pp.get("price") or {}
    final = None
    if pp.get("has_final_price"):
        v = fp.get("single_value")
        final = {"price": twd(v) if v and v > 0 else twd(fp.get("range_min")),
                 "price_max": twd(fp.get("range_max")) if (fp.get("range_max") or -1) > 0 else None,
                 "hint": (pp.get("final_price_info") or {}).get("hint_text"),
                 "vouchers": [v_.get("voucher_code") for v_ in pp.get("final_price_vouchers") or []]}
    ship = data.get("product_shipping") or {}
    chans = [c.get("name") for c in ship.get("ungrouped_channel_infos") or [] if c.get("name")]
    feep = (ship.get("shipping_fee_info") or {}).get("price") or {}
    if (feep.get("single_value") or -1) >= 0:
        fee_txt = f" (運費 {nt(twd(feep['single_value']))})"
    elif (feep.get("range_min") or -1) >= 0:
        fee_txt = f" (運費 {nt(twd(feep['range_min']))}~{twd(feep.get('range_max')):,.0f})"
    else:
        fee_txt = ""
    rev = data.get("product_review") or {}
    any_stock = any(m["in_stock"] for m in models) if models else (it.get("stock") or 0) > 0 or it.get("stock_display") == "尚有庫存"
    in_stock = bool(any_stock) and not it.get("is_unavailable") and it.get("status", 1) == 1
    return {
        "id": f"{shopid}.{itemid}",
        "shopid": shopid,
        "itemid": itemid,
        "title": it.get("title"),
        "brand": it.get("brand") or None,
        "price": None if hidden else twd(it.get("price_min")),
        "price_max": None if hidden else twd(it.get("price_max")),
        "orig_price": twd(it.get("price_min_before_discount")),
        "orig_price_max": twd(it.get("price_max_before_discount")),
        "discount_pct": it.get("raw_discount"),
        "final_price": final,
        "price_hidden": hidden,
        "promo": ", ".join(x for x in [
            (f"{(final['hint'] or '券後價').rstrip(' >')} {nt(final['price'])} ({'/'.join(final['vouchers'])})" if final else None),
            ("免運" if it.get("is_free_shipping") else None)] if x) or None,
        "stock": it.get("stock") if it.get("stock") is not None else it.get("stock_display"),
        "in_stock": in_stock,
        "max_quantity": it.get("max_quantity"),
        "rating": rev.get("rating_star") or (it.get("item_rating") or {}).get("rating_star"),
        "reviews": rev.get("total_rating_count"),
        "sold": rev.get("historical_sold"),
        "shop": {"name": shop.get("name"), "official": bool(shop.get("is_official_shop")),
                 "rating": shop.get("rating_star")},
        "shop_location": it.get("shop_location") or shop.get("shop_location"),
        "shipping": ", ".join(chans) + fee_txt if chans else None,
        "tiers": tiers,
        "models": models,
        "url": product_url(shopid, itemid),
    }


# ------------------------------------------------------------------ doctor
def cmd_doctor(args):
    """Cheap by design: CDP + Edge cookies are local; the only Shopee request is
    one plain-HTTPS get_account_info for the saved session (paced). `--live`
    additionally loads one search page in a background tab."""
    _set_cdp(args.cdp)
    checks = []
    st = load_state()
    edge = None
    try:
        ver = _http_json("/json/version")
        checks.append(("cdp", True, f"{ver.get('Browser')} on {CDP}"))
        edge, _ = edge_cookies()
        checks.append(("edge_signed_in", _signed_in(edge),
                       f"shopee.tw SPC_U={_cookie_val(edge, 'SPC_U')}, SPC_ST "
                       f"{'present' if _cookie_val(edge, 'SPC_ST') else 'missing'}"))
    except Net as e:
        checks.append(("cdp", False, str(e)))
    left = _cooldown_left()
    checks.append(("cooldown", left <= 0, "none" if left <= 0 else f"{int(left)} s left (after a Shopee block)"))
    checks.append(("pacing", True, f"{min_interval():g} s between requests (SHOPEE_MIN_INTERVAL), "
                                   f"result-page cache {CACHE_TTL} s"))
    saved = st.get("cookies") or []
    checks.append(("saved_session", _signed_in(saved),
                   f"{st.get('source') or 'none'} ({len(saved)} cookies, SPC_U={_cookie_val(saved, 'SPC_U')})"))
    if _signed_in(saved) and left <= 0:
        try:
            u = fetch_account(saved, st.get("ua") or DEFAULT_UA, "http", args)
            checks.append(("login_http", True, f"{u.get('username')} (userid {u.get('userid')}) via plain HTTPS"))
            if edge is not None and _cookie_val(edge, "SPC_U") != _cookie_val(saved, "SPC_U"):
                checks.append(("edge_matches_saved", False, "Edge is signed in as a different user / signed out"))
        except (Auth, Net, ApiError) as e:
            checks.append(("login_http", False, str(e)))
    if args.live and left <= 0 and edge is not None:
        try:
            with Client(args, st) as cl:
                d = cl.page_api(_search_page_url("衛生紙", "relevance", 0), "/api/v4/search/search_items",
                                what="search_items")
                checks.append(("live_search_page", True, f"total_count={d.get('total_count')}, "
                                                         f"{len(d.get('items') or [])} items"))
        except (Net, ApiError, Auth) as e:
            checks.append(("live_search_page", False, str(e)))
    data = {k: {"ok": v, "detail": d} for k, v, d in checks}
    ready = all(v for k, v, _ in checks if k in ("cdp", "edge_signed_in", "cooldown", "live_search_page"))
    data["ok"] = ready

    def human():
        lines = [f"shopee doctor (v{VERSION})"]
        for k, v, d in checks:
            lines.append(f"  [{'ok  ' if v else 'FAIL'}] {k:<18} {d}")
        lines.append("ready" if ready else "NOT ready")
        return "\n".join(lines)

    if args.json:
        return emit(ok(data) if ready else err("doctor: not ready", EX_NET, checks=data), True)
    print(human())
    return EX_OK if ready else EX_NET


# ------------------------------------------------------------------ parser
class Parser(argparse.ArgumentParser):
    def error(self, message):
        as_json = "--json" in sys.argv
        emit(err(f"{self.prog}: {message}", EX_USAGE), as_json)
        if not as_json:
            self.print_usage(sys.stderr)
        sys.exit(EX_USAGE)


def build_parser():
    p = Parser(prog="shopee", description="Shopee Taiwan (shopee.tw) buyer CLI: search, product, price, cart. No checkout.")
    p.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="stable {ok, data|error} envelope")
    common.add_argument("--debug", action="store_true", help="dump requests to stderr")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="transport: browser = signed XHR in a background Edge tab (measured required for "
                             "/api/v4 search/pdp/cart), http = plain HTTPS, auto (default)")
    common.add_argument("--cdp", default=None, help=f"CDP endpoint (default {CDP}, env SHOPEE_CDP)")
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=Parser)

    dr = sub.add_parser("doctor", parents=[common], help="CDP, Edge sign-in, saved session, cool-down")
    dr.add_argument("--live", action="store_true", help="also load one search page (one Shopee request)")
    dr.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("search", parents=[common], help="search products")
    s.add_argument("query")
    s.add_argument("--sort", choices=list(SORTS), default="relevance")
    s.add_argument("--page", type=int, default=1)
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--min", type=float, help="min price TWD (filters the fetched pool)")
    s.add_argument("--max", type=float, help="max price TWD (filters the fetched pool)")
    s.add_argument("--fresh", action="store_true", help="ignore the 10-minute result-page cache")
    s.set_defaults(fn=cmd_search)

    pr = sub.add_parser("product", aliases=["item"], parents=[common], help="one product with variants")
    pr.add_argument("ref", help="<shopid>.<itemid> or shopee.tw product URL")
    pr.set_defaults(fn=cmd_product)

    pc = sub.add_parser("price", parents=[common], help="quick price check for several products")
    pc.add_argument("refs", nargs="+")
    pc.set_defaults(fn=cmd_price)

    lg = sub.add_parser("login", parents=[common], help="save a signed-in shopee.tw session (never passwords)")
    g = lg.add_mutually_exclusive_group()
    g.add_argument("--from-browser", action="store_true", help="(default) copy the session from Edge on CDP")
    g.add_argument("--from-clipboard", action="store_true", help="Cookie header from the clipboard")
    g.add_argument("--cookie-stdin", action="store_true", help="Cookie header on stdin")
    lg.add_argument("--wait", type=int, default=300, help="seconds to wait for you to sign in in Edge")
    lg.add_argument("--keyring", action="store_true", help="store cookies in the OS keyring")
    lg.set_defaults(fn=cmd_login)
    sub.add_parser("logout", parents=[common], help="delete the saved session").set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", parents=[common], help="verify the saved session").set_defaults(fn=cmd_whoami)

    c = sub.add_parser("cart", parents=[common], help="cart list (read-only; add/qty/rm are disabled, see README)")
    csub = c.add_subparsers(dest="cart_cmd", required=True, parser_class=Parser)
    csub.add_parser("list", parents=[common]).set_defaults(fn=cmd_cart_list)
    ca = csub.add_parser("add", parents=[common])
    ca.add_argument("ref")
    ca.add_argument("--qty", type=int, default=1)
    ca.add_argument("--model", "--spec", "--opt", dest="model", help="modelid, or text matching the variant name")
    ca.add_argument("--yes", action="store_true", help="(disabled) cart writes are refused")
    ca.set_defaults(fn=cmd_cart_write)
    cr = csub.add_parser("rm", parents=[common])
    cr.add_argument("ref", help="line number from `cart list`, or <shopid>.<itemid>[.<modelid>]")
    cr.add_argument("--yes", action="store_true")
    cr.set_defaults(fn=cmd_cart_write)
    cq = csub.add_parser("qty", parents=[common])
    cq.add_argument("ref", help="line number from `cart list`, or <shopid>.<itemid>[.<modelid>]")
    cq.add_argument("qty", type=int)
    cq.add_argument("--yes", action="store_true")
    cq.set_defaults(fn=cmd_cart_write)

    r = sub.add_parser("raw", parents=[common], help="GET passthrough (signed) for debugging")
    r.add_argument("path")
    r.set_defaults(fn=cmd_raw)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if getattr(args, "cdp", None):
        _set_cdp(args.cdp)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except Usage as e:
        return emit(err(str(e), EX_USAGE), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
