LOGIN_URL = ORIGIN + "/buyer/login"


def fetch_account(cookies, ua, via="http", args=None):
    """GET /api/v4/account/basic/get_account_info with the given session."""
    st = {"cookies": cookies, "ua": ua}
    if via == "http":
        code, text = Http(st, getattr(args, "debug", False)).request("GET", "/api/v4/account/basic/get_account_info")
        d = _check_block(_json(text, "get_account_info"), "get_account_info", "http")
    else:
        with Client(args, st, need_session=True) as cl:
            _, d = cl.api("GET", "/api/v4/account/basic/get_account_info", what="get_account_info")
    data = d.get("data") if isinstance(d, dict) else None
    if d.get("error") or not data or not data.get("userid"):
        raise Auth(f"session rejected by get_account_info (error {d.get('error')}) - run `shopee login`")
    return {"userid": data.get("userid"), "username": data.get("username"), "nickname": data.get("nickname"),
            "email": data.get("email"), "phone": data.get("phone"), "shopid": data.get("shopid")}


def _verify(cookies, ua, args):
    try:
        return fetch_account(cookies, ua, "http", args), "http"
    except Blocked:
        return fetch_account(cookies, ua, "browser", args), "browser"


def _clipboard():
    for cmd in (["wl-paste", "-n"], ["pbpaste"], ["xclip", "-o", "-selection", "clipboard"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    raise Auth("clipboard is empty or no clipboard tool (wl-paste / pbpaste / xclip)")


def cmd_login(args):
    _set_cdp(args.cdp)
    if args.from_clipboard or args.cookie_stdin:
        raw = _clipboard() if args.from_clipboard else sys.stdin.read()
        cookies = header_to_cookies(clean_cookie(raw))
        if not _signed_in(cookies):
            raise Auth("that Cookie header has no signed-in SPC_U; copy it from a logged-in shopee.tw request")
        ua = os.environ.get("SHOPEE_UA") or DEFAULT_UA
        src = "clipboard" if args.from_clipboard else "stdin"
    else:
        cookies, ua = edge_cookies()
        if not _signed_in(cookies):
            print(f"Not signed in on shopee.tw in Edge ({CDP}). Opening the sign-in page in a background "
                  f"tab; sign in there yourself (waiting up to {args.wait}s). This CLI never types passwords/OTP.",
                  file=sys.stderr)
            br = Browser(args.debug, LOGIN_URL, wait=False)
            try:
                t0 = time.time()
                while time.time() - t0 < args.wait:
                    time.sleep(4)
                    cookies, ua = edge_cookies()
                    if _signed_in(cookies):
                        break
                else:
                    raise Auth(f"not signed in after {args.wait}s - sign in on shopee.tw in Edge and retry")
            finally:
                br.close()
        src = f"browser {CDP}"
    user, verified_via = _verify(cookies, ua, args)
    st = load_state()
    if st.get("keyring_parts"):
        keyring_clear(st["keyring_parts"])
    for k in ("keyring_parts", "keyring_error", "source"):
        st.pop(k, None)
    st.update(cookies=cookies, ua=ua, cookie_in_keyring=bool(args.keyring), user=user,
              logged_in_at=int(time.time()), login_source=src)
    if args.keyring:
        st["keyring_parts"] = keyring_save(cookies)
        if keyring_load(st["keyring_parts"]) != cookies:
            raise Auth("keyring verification failed; use the state file")
    save_state(st)
    out = {"user": user, "verified_via": verified_via, "cookies_count": len(cookies),
           "stored": "keyring" if args.keyring else STATE_FILE, "source": src}
    return emit(ok(out), args.json, lambda: (
        f"Signed in as {user.get('username')} (userid {user.get('userid')}); verified via {verified_via}; "
        f"session ({len(cookies)} cookies) saved to {out['stored']}"))


def cmd_logout(args):
    st = load_state()
    if st.get("cookie_in_keyring"):
        keyring_clear(st.get("keyring_parts"))
    for k in ("cookies", "cookie_in_keyring", "keyring_parts", "keyring_error", "user",
              "logged_in_at", "login_source", "source", "ua"):
        st.pop(k, None)
    save_state(st)
    return emit(ok({"logged_out": True, "note": "only the CLI's saved session was deleted; Edge is untouched"}),
                args.json, "Saved Shopee session removed (Edge's own sign-in is untouched).")


def cmd_whoami(args):
    st = load_state()
    cookies = st.get("cookies")
    if not cookies:
        raise Auth(st.get("keyring_error") or "not signed in - run `shopee login`")
    via = "browser" if args.via == "browser" else "http"
    try:
