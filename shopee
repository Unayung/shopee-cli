    out = dict(u, logged_in=True, verified_via=via, cookies_count=len(cookies), source=st.get("source"))
    return emit(ok(out), args.json, lambda: (
        f"{u.get('username')}" + (f" ({u['nickname']})" if u.get("nickname") else "") + f"  userid {u.get('userid')}\n"
        f"email:   {u.get('email') or ''}\nphone:   {u.get('phone') or ''}\n"
