def get_pdp(cl, shopid, itemid):
    d = cl.page_api(product_url(shopid, itemid), "/api/v4/pdp/get_pc", what="pdp/get_pc")
    _dump(f"pdp_{shopid}_{itemid}", d)
    if d.get("error"):
        raise ApiError(f"pdp/get_pc error {d.get('error')}: {d.get('error_msg')}", {"error": d.get("error")})
    data = d.get("data") or {}
    if not data.get("item"):
        raise ApiError(f"product {shopid}.{itemid} not found", {"body": json.dumps(d)[:300]})
    return parse_pdp(data, shopid, itemid)


