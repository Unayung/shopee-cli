CART_URL = ORIGIN + "/cart"


def _brief_key(b):
    return (int(b["shopid"]), int(b["itemid"]), int(b.get("modelid") or 0))


def load_cart(cl):
    """Open the real cart page in the background tab and read the page's own
    /api/v4/cart/get reply. It lists EVERY line (cart_block_id_list item_briefs:
    shopid/itemid/modelid/quantity) but details (name, price, stock, checkout
    flag) only for the first pagination_info.item_limit lines (20, measured). The
    page loads the rest on scroll via an observer that does not fire in a hidden
    background tab (8 scrolls measured: no further cart/get), so lines past 20
    are listed without name/price."""
    d = cl.page_api(CART_URL, "/api/v4/cart/get", what="cart/get")
    _dump("cart_get", d)
    if d.get("error"):
        raise ApiError(f"cart/get error {d.get('error')}: {d.get('error_msg')}", {"error": d.get("error")})
    data = d.get("data") or {}
    briefs = [b for blk in data.get("cart_block_id_list") or [] for b in blk.get("item_briefs") or []]
    details = {}

    def absorb(dd):
        for blk in (dd.get("data") or {}).get("cart_blocks") or []:
            shopname = ((blk.get("shops") or [{}])[0] or {}).get("shopname")
            for it in blk.get("items") or []:
                details[_brief_key(it)] = dict(it, _shopname=shopname)

    absorb(d)
    lines = []
    for n, b in enumerate(briefs, 1):
        it = details.get(_brief_key(b)) or {}
        price = twd(it.get("price")) if it else None
        q = b.get("quantity")
        lines.append({
            "line": n, "shopid": b["shopid"], "itemid": b["itemid"], "modelid": b.get("modelid"),
            "id": f"{b['shopid']}.{b['itemid']}",
            "title": it.get("name"), "spec": it.get("model_name") or None,
            "quantity": q, "unit_price": price,
            "subtotal": price * q if price is not None and q else None,
            "selected": it.get("checkout") if it else None,
            "status": it.get("status"), "stock": it.get("stock"),
            "shop": it.get("_shopname"),
        })
    return {"lines": lines, "line_count": len(lines), "detailed": len(details),
            "selected_count": sum(1 for x in lines if x["selected"]),
            "selected_total": sum(x["subtotal"] or 0 for x in lines if x["selected"])}


def _cart_client(args):
    st = load_state()
    if not st.get("cookies"):
        raise Auth(st.get("keyring_error") or "cart commands need a saved session - run `shopee login`")
    return Client(args, st, need_session=True)


